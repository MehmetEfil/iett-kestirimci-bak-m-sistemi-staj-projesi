# Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinizi girin (.env git'e gönderilmez)

# İBB / İETT Açık Veri SOAP API kimlik bilgileri
# Başvuru: https://data.ibb.gov.tr
IETT_USER=kullanici_adiniz
IETT_PASS=sifreniz

# (Opsiyonel) Yedek SQL sorguları için MSSQL sunucu adı.
# Panel çoğunlukla önceden hesaplanmış JSON/CSV ile çalışır; SQL yalnızca fallback'tir.
SQL_SERVER=localhost\SQLEXPRESS
